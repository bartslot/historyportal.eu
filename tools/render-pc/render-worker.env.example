# Copy to /etc/historyportal/render-worker.env on the render PC (chmod 600).
HP_SERVER=https://historyportal.eu
# The same value as RENDER_PC_TOKEN in the server's .env
RENDER_PC_TOKEN=
COMFY_URL=http://127.0.0.1:8188
# The MiniMax H3 workflow, exported from ComfyUI with "Save (API format)", with placeholders (see README.md)
COMFY_WORKFLOW=/home/comfy/historyportal/workflow.api.json
# Films dropped here as scene-14.mp4 or lesson-129-scene-14.mp4 go to that scene
HP_WATCH_DIR=/home/comfy/historyportal-films
RENDER_FPS=24
