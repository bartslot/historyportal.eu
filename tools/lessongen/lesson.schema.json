{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lesson.json (contract 2, autonomous-lessons plan 2026-10-27)",
  "type": "object",
  "required": [
    "id",
    "lang",
    "age",
    "canon_venster",
    "bundle",
    "sources",
    "blueprint",
    "scenes",
    "needed_assets"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "lang": {
      "enum": [
        "nl",
        "en",
        "de",
        "fr",
        "it",
        "es"
      ]
    },
    "age": {
      "type": "integer",
      "minimum": 6,
      "maximum": 16
    },
    "level": {
      "type": "string"
    },
    "canon_venster": {
      "type": "string"
    },
    "bundle": {
      "enum": [
        "nl-prehistory",
        "nl-golden-age",
        "near-east-neolithic",
        "babylonia-old-babylonian",
        "babylon-neo-babylonian"
      ]
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "ledger"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "look": {
            "type": "string"
          },
          "ledger": {
            "enum": [
              "sourced",
              "inferred",
              "invented"
            ]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "canon",
              "lessonup-blueprint",
              "wikipedia",
              "archive",
              "museum",
              "scholarly",
              "ledger"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "blueprint": {
      "type": "object",
      "required": [
        "lessonup_ids",
        "begrippen",
        "goals"
      ],
      "properties": {
        "lessonup_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "begrippen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "needed_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tags",
          "layer",
          "why"
        ],
        "properties": {
          "tags": {
            "type": "string"
          },
          "layer": {
            "enum": [
              "sky",
              "bg",
              "mid",
              "fg",
              "prop",
              "figure"
            ]
          },
          "why": {
            "type": "string"
          },
          "bundle": {
            "enum": [
              "nl-prehistory",
              "nl-golden-age",
              "near-east-neolithic",
              "babylonia-old-babylonian",
              "babylon-neo-babylonian"
            ],
            "description": "absent = the lesson bundle"
          }
        }
      }
    },
    "teacher": {
      "type": "string",
      "description": "teacher card: goals, duration, warnings (not shown to the class)"
    },
    "related_venster": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "teacher_template": {
      "type": "string",
      "description": "teacher card with {total_min}, {story_min}, {min:scA-scB}; --resolve renders `teacher` from it"
    },
    "narration": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "root": {
          "type": "string"
        }
      }
    },
    "game": {
      "type": "object",
      "required": [
        "meters"
      ],
      "additionalProperties": false,
      "description": "a branching story game (player: lessons.game_type story_game): the class meters every branch moves",
      "properties": {
        "meters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label",
              "start"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$",
                "description": "tabler icon class, e.g. ti-flame"
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "fail_threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "a meter at or below it = game over (default 0)"
        }
      }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": [
        "id",
        "beat",
        "narration",
        "est_s",
        "interaction",
        "fact_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sc[0-9]{2,3}$"
        },
        "kind": {
          "enum": [
            "story",
            "map"
          ],
          "description": "story (default): a 3D stage shot; map: the lesson map shows where it happens (needs `map`, carries no set, figures, balloons, camera or sound)"
        },
        "act": {
          "type": "string"
        },
        "beat": {
          "enum": [
            "hook",
            "setup",
            "cause",
            "effect",
            "turn",
            "climax",
            "recap"
          ]
        },
        "where_when": {
          "type": "string"
        },
        "chapter": {
          "type": "string",
          "description": "the chapter this shot belongs to (a group of script scenes): one segment on the player's bar"
        },
        "chapter_year": {
          "type": "string",
          "description": "on the first shot of a chapter: the year its chapter card shows, e.g. about 3000 BCE"
        },
        "on_screen": {
          "type": "string"
        },
        "narration": {
          "type": "string"
        },
        "est_s": {
          "type": "number"
        },
        "set": {
          "type": "object",
          "required": [
            "sky",
            "layers"
          ],
          "properties": {
            "sky": {
              "type": "string"
            },
            "layers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "need",
                  "asset",
                  "depth",
                  "x",
                  "scale"
                ],
                "additionalProperties": false,
                "properties": {
                  "need": {
                    "type": "string"
                  },
                  "asset": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "depth": {
                    "enum": [
                      "bg",
                      "mid",
                      "fg"
                    ]
                  },
                  "x": {
                    "type": "number",
                    "minimum": -0.5,
                    "maximum": 1.5
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        },
        "figures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "char",
              "pose",
              "x",
              "depth",
              "facing",
              "expression"
            ],
            "properties": {
              "char": {
                "type": "string"
              },
              "pose": {
                "enum": [
                  "walk",
                  "stand",
                  "point",
                  "kneel",
                  "carry",
                  "sit",
                  "pull",
                  "push",
                  "row",
                  "climb",
                  "lie",
                  "dig",
                  "front",
                  "side",
                  "back34",
                  "back",
                  "walk-back",
                  "bust",
                  "bust-front",
                  "bust-side",
                  "bust-back",
                  "bust-low",
                  "bust-high",
                  "bust-afraid",
                  "bust-amazed",
                  "sling",
                  "forbid",
                  "guard",
                  "read",
                  "sickle"
                ]
              },
              "x": {
                "type": "number"
              },
              "depth": {
                "enum": [
                  "bg",
                  "mid",
                  "fg"
                ]
              },
              "facing": {
                "enum": [
                  "left",
                  "right"
                ]
              },
              "expression": {
                "enum": [
                  "neutral",
                  "happy",
                  "worried",
                  "surprised",
                  "angry",
                  "sad",
                  "tired",
                  "proud"
                ]
              },
              "holds": {
                "type": "string"
              }
            }
          }
        },
        "balloons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "char",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "char": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "camera": {
          "description": "null = the director picks the move. The writer may ask for one: { \"move\": ... } ('track' = truck; 'hold' = a still camera for a breath shot). The director fills in the poses.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "if": {
                "not": {
                  "required": ["from"]
                }
              },
              "then": {
                "required": ["move"],
                "properties": {
                  "move": {
                    "enum": ["push", "pull", "truck", "track", "pan", "tilt", "rack", "hold"]
                  }
                }
              }
            }
          ]
        },
        "sound": {},
        "interaction": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/quiz"
            },
            {
              "$ref": "#/$defs/power_meter"
            },
            {
              "$ref": "#/$defs/choice"
            }
          ]
        },
        "fact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        },
        "bundle": {
          "enum": [
            "nl-prehistory",
            "nl-golden-age",
            "near-east-neolithic",
            "babylonia-old-babylonian",
            "babylon-neo-babylonian"
          ],
          "description": "overrides the lesson bundle for this scene's art and sound"
        },
        "class_action_s": {
          "type": "number",
          "minimum": 0,
          "maximum": 180,
          "description": "time written for a class action in this shot (timing.json)"
        },
        "tts_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "measured narration seconds; overrides the words/s estimate"
        },
        "audio": {
          "type": "string",
          "description": "narration mp3, '<lesson id>/<scene id>.mp3' relative to lesson.narration.root (written by narrate.py)"
        },
        "branch": {
          "oneOf": [
            {
              "$ref": "#/$defs/branch_question"
            },
            {
              "$ref": "#/$defs/branch_option"
            }
          ]
        },
        "map": {
          "$ref": "#/$defs/map"
        },
        "panel": {
          "type": "object",
          "properties": {
            "image": {
              "type": "string",
              "description": "absolute local path to the painted panel (.png, .webp, .jpg)"
            }
          },
          "required": [
            "image"
          ],
          "additionalProperties": false,
          "description": "a dramatic moment as a whole painted comic panel: a picture scene with a slow push-in, no stage set"
        },
        "caption": {
          "type": "object",
          "properties": {
            "place": {
              "type": "string"
            },
            "year": {
              "type": "string"
            }
          },
          "required": [
            "place"
          ],
          "additionalProperties": false,
          "description": "place-and-year card shown over the scene (an introduction date card)"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "map"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "map"
        ],
        "properties": {
          "set": false,
          "figures": false,
          "balloons": false,
          "camera": false,
          "sound": false,
          "panel": false
        }
      },
      "else": {
        "properties": {
          "map": false
        },
        "if": {
          "required": [
            "panel"
          ]
        },
        "then": {},
        "else": {
          "required": [
            "set",
            "figures",
            "balloons",
            "camera",
            "sound"
          ]
        }
      }
    },
    "quiz": {
      "type": "object",
      "required": [
        "type",
        "question",
        "options",
        "correct",
        "bloom",
        "explain"
      ],
      "properties": {
        "type": {
          "const": "quiz"
        },
        "format": {
          "enum": [
            "mc",
            "true-false",
            "sort",
            "open",
            "team"
          ]
        },
        "question": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "correct": {
          "type": [
            "integer",
            "array",
            "null"
          ]
        },
        "bloom": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "explain": {
          "type": "string"
        },
        "misconception": {
          "type": "string"
        },
        "est_s": {
          "type": "number",
          "minimum": 20,
          "maximum": 180,
          "description": "ignored: timing.json interaction_s decides"
        },
        "class_action_s": {
          "type": "number",
          "minimum": 20,
          "maximum": 300,
          "description": "play time of a team/paper activity (format team)"
        }
      },
      "if": {
        "properties": {
          "format": {
            "const": "team"
          }
        },
        "required": [
          "format"
        ]
      },
      "then": {
        "required": [
          "class_action_s"
        ]
      }
    },
    "power_meter": {
      "type": "object",
      "required": [
        "type",
        "name",
        "moves",
        "input",
        "right",
        "wrong",
        "prompt",
        "payoff",
        "why"
      ],
      "properties": {
        "type": {
          "const": "power-meter"
        },
        "name": {
          "type": "string"
        },
        "moves": {
          "type": "string"
        },
        "input": {
          "enum": [
            "woorden",
            "blazen",
            "luider",
            "ritme",
            "stilte",
            "schudden"
          ]
        },
        "right": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        },
        "wrong": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "string"
          }
        },
        "prompt": {
          "type": "string"
        },
        "payoff": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "dramatisation": {
          "type": "boolean"
        },
        "est_s": {
          "type": "number",
          "minimum": 20,
          "maximum": 180,
          "description": "ignored: timing.json interaction_s decides"
        }
      }
    },
    "choice": {
      "type": "object",
      "required": [
        "type",
        "prompt",
        "options"
      ],
      "properties": {
        "type": {
          "const": "choice"
        },
        "prompt": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "text",
              "outcome"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              }
            }
          }
        },
        "history": {
          "type": "string"
        },
        "est_s": {
          "type": "number",
          "minimum": 20,
          "maximum": 180,
          "description": "ignored: timing.json interaction_s decides"
        },
        "format": {
          "enum": [
            "class",
            "vote",
            "team"
          ],
          "description": "vote = class votes with hands (60 s); team = groups of 3-4 (time = class_action_s)"
        },
        "class_action_s": {
          "type": "number",
          "minimum": 20,
          "maximum": 300,
          "description": "play time of a team/paper activity (format team)"
        }
      },
      "if": {
        "properties": {
          "format": {
            "const": "team"
          }
        },
        "required": [
          "format"
        ]
      },
      "then": {
        "required": [
          "class_action_s"
        ]
      }
    },
    "branch_question": {
      "type": "object",
      "required": [
        "group",
        "role",
        "labels"
      ],
      "additionalProperties": false,
      "description": "the scene after which the class chooses; labels = the two buttons",
      "properties": {
        "group": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "const": "question"
        },
        "labels": {
          "type": "object",
          "required": [
            "a",
            "b"
          ],
          "additionalProperties": false,
          "properties": {
            "a": {
              "type": "string",
              "minLength": 1
            },
            "b": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "branch_option": {
      "type": "object",
      "required": [
        "group",
        "role"
      ],
      "additionalProperties": false,
      "description": "one shot of an option run (1-3 shots); the run's FIRST shot carries effects, applied when the run ends",
      "properties": {
        "group": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "option_a",
            "option_b"
          ]
        },
        "effects": {
          "type": "object",
          "required": [
            "deltas"
          ],
          "additionalProperties": false,
          "properties": {
            "deltas": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "integer",
                "minimum": -25,
                "maximum": 25
              }
            },
            "consequence_line": {
              "type": "string"
            },
            "historical_note": {
              "type": "string"
            }
          }
        }
      }
    },
    "lnglat": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -85,
          "maximum": 85
        }
      ],
      "description": "[lng, lat] in degrees"
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "description": "A map scene: the painted lesson map with labels, a highlighted region and/or a route. No camera = the map frames the labels and the route.",
      "anyOf": [
        {
          "required": [
            "labels"
          ]
        },
        {
          "required": [
            "region"
          ]
        },
        {
          "required": [
            "route"
          ]
        }
      ],
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "lng",
              "lat"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "lng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "lat": {
                "type": "number",
                "minimum": -85,
                "maximum": 85
              },
              "kind": {
                "enum": [
                  "city",
                  "river",
                  "region",
                  "camp"
                ],
                "description": "city and camp get a dot; river and region a name only (default city)"
              }
            }
          }
        },
        "region": {
          "type": "object",
          "required": [
            "name",
            "highlight"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "highlight": {
              "type": "string",
              "pattern": "^[a-z0-9-]+(\\.geojson)?$",
              "description": "a region in public/map-regions: 'fertile-crescent', or a polygon file there ('indus-valley.geojson')"
            }
          }
        },
        "route": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/lnglat"
          },
          "description": "a dashed ink line through these points, in order"
        },
        "camera": {
          "type": "object",
          "required": [
            "center",
            "zoom"
          ],
          "additionalProperties": false,
          "properties": {
            "center": {
              "$ref": "#/$defs/lnglat"
            },
            "zoom": {
              "type": "number",
              "minimum": 1.6,
              "maximum": 8
            }
          }
        }
      }
    }
  }
}
